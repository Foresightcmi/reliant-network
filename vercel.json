{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["services/data/**", "config/**", "apps/web/public/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web/server.js"
    }
  ]
}
