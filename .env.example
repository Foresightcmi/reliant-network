# ==============================================================================
# RELIANT VERIFIED - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Stripe API Keys (Get yours at https://dashboard.stripe.com/test/apikeys)
# 1. Reveal your Secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# 2. Copy your Publishable key (starts with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional: Stripe Webhook Secret (for production signature verification)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Server Port (defaults to 3000)
PORT=3000
